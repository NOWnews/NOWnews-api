{
  "apps" : [{
    "name"        : "cron",
    "script"      : "./bin/cron.js",
    "watch"       : false,
    "env": {
      "NODE_ENV": "develop"
    },
    "env_staging" : {
      "NODE_ENV": "staging"
    },
    "env_china" : {
      "NODE_ENV": "china-gcp-cron"
    },
    "env_production" : {
      "NODE_ENV": "production"
    },
    "instances"  : 1,
    "log_date_format" : "YYYY-MM-DD HH:mm Z",
    "out_file": "/dev/null"
  }]
}